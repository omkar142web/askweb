{
  "name": "rutkar",
  "version": "1.0.1",
  "description": "Automate ChatGPT from the command line using a real Chromium-based browser with Playwright. Send questions, attach files, and save responses as Markdown.",
  "main": "index.js",
  "bin": {
    "askweb": "index.js"
  },
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "test:popup": "node tests/popup-resilience.test.js",
    "ask": "node index.js",
    "new": "node index.js --new",
    "cont": "node index.js --continue",
    "forget": "node index.js --clear-conversation",
    "wipe": "node index.js --clear-conversations",
    "pdf": "node -e \"const {generatePDF}=require('./pdf-generator');const fs=require('fs');const text=fs.readFileSync(process.argv[2]||'output.md','utf8');generatePDF(text,{outputDir:'.'}).then(p=>console.log('PDF saved:',p)).catch(e=>{console.error(e);process.exit(1);});\"",
    "test-pdf": "node -e \"const {generatePDF}=require('./pdf-generator');generatePDF.fromFile('test-markdown.md',{title:'PDF Test'}).then(p=>console.log('Test PDF saved:',p)).catch(e=>{console.error(e);process.exit(1);});\""
  },
  "keywords": [
    "chatgpt",
    "cli",
    "playwright",
    "browser-automation",
    "ai"
  ],
  "author": "omkar142web",
  "license": "ISC",
  "type": "commonjs",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/omkar142web/askweb.git"
  },
  "homepage": "https://github.com/omkar142web/askweb#readme",
  "bugs": {
    "url": "https://github.com/omkar142web/askweb/issues"
  },
  "files": [
    "index.js",
    "chatgpt-ui.js",
    "pdf-generator.js",
    "markdown-to-html.js",
    "pdf-template.js",
    "file-id-generator.js"
  ],
  "dependencies": {
    "dompurify": "^3.4.14",
    "dotenv": "^17.4.2",
    "highlight.js": "^11.12.0",
    "jsdom": "^29.1.1",
    "katex": "^0.18.4",
    "marked": "^18.0.11",
    "playwright": "^1.62.1",
    "playwright-extra": "^4.3.6",
    "puppeteer-extra-plugin-stealth": "^2.11.2"
  }
}
