{
  "name": "rutkar",
  "version": "1.0.0",
  "description": "Automate ChatGPT from the command line using a real Chromium-based browser with Playwright. Send questions, attach files, and save responses as Markdown.",
  "main": "index.js",
  "bin": {
    "askweb": "index.js"
  },
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "test:popup": "node tests/popup-resilience.test.js",
    "ask": "node index.js",
    "new": "node index.js --new",
    "cont": "node index.js --continue",
    "forget": "node index.js --clear-conversation",
    "wipe": "node index.js --clear-conversations"
  },
  "keywords": [
    "chatgpt",
    "cli",
    "playwright",
    "browser-automation",
    "ai"
  ],
  "author": "omkar142web",
  "license": "ISC",
  "type": "commonjs",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/omkar142web/askweb.git"
  },
  "homepage": "https://github.com/omkar142web/askweb#readme",
  "bugs": {
    "url": "https://github.com/omkar142web/askweb/issues"
  },
  "files": [
    "index.js",
    "chatgpt-ui.js"
  ],
  "dependencies": {
    "dotenv": "^17.4.2",
    "playwright": "^1.62.1",
    "playwright-extra": "^4.3.6",
    "puppeteer-extra-plugin-stealth": "^2.11.2"
  }
}
